import gc
import itertools
from pathlib import Path

import lightgbm as lgb
import numpy as np
import pandas as pd
from catboost import CatBoostRegressor
from lightgbm import LGBMRegressor
from sklearn.metrics import root_mean_squared_log_error

# ==========================================
# 1. ПУТИ К ФАЙЛАМ (ОБНОВЛЕНО ПО СКРИНШОТУ)
# ==========================================
# Все parquet-файлы лежат прямо в /kaggle/working/
DATA_DIR = Path("/kaggle/working")
OUTPUT_DIR = Path("/kaggle/working")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

SNAPSHOTS = {
    "aug17": DATA_DIR / "train_-1_predict_from_2025-08-17.parquet",
    "sep16": DATA_DIR / "train_0_predict_from_2025-09-16.parquet",
    "oct16": DATA_DIR / "train_1_predict_from_2025-10-16.parquet",
    "nov15": DATA_DIR / "train_2_predict_from_2025-11-15.parquet",
    "dec15": DATA_DIR / "train_3_predict_from_2025-12-15.parquet",
    "jan14": DATA_DIR / "test_for_us_predict_from_2026-01-14.parquet",
}

MARCH8_ANALOG_FILE = DATA_DIR / "train_m1_predict_from_2025-02-13.parquet"
HAS_MARCH8_ANALOG = MARCH8_ANALOG_FILE.exists()

COMPETITION_FILE = DATA_DIR / "competition_test.parquet"

FOLD_ORDER = ["aug17", "sep16", "oct16", "nov15", "dec15", "jan14"]

MARCH8_SAMPLE_WEIGHT = 3.0

EXCLUDED_COLUMNS = {"user_id", "cutoff_date", "target"}


# ==========================================
# 2. СХЕМА ПРИЗНАКОВ И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ==========================================
schema_df = pd.read_parquet(SNAPSHOTS["oct16"])
FEATURES = [c for c in schema_df.columns if c not in EXCLUDED_COLUMNS]
print(f"Признаков: {len(FEATURES)}")
del schema_df
gc.collect()


def load_snapshot(path, with_target=True):
    columns = FEATURES + (["target"] if with_target else [])
    df = pd.read_parquet(path, columns=["user_id"] + columns)
    df[FEATURES] = df[FEATURES].astype("float32")
    if with_target:
        df["target"] = df["target"].astype("float32")
    return df


def concat_with_weights(names, weight_map):
    """Конкатенирует срезы и возвращает parallel-массив sample_weight."""
    frames, weights = [], []
    for name in names:
        df = (
            load_snapshot(MARCH8_ANALOG_FILE)
            if name == "march8_analog"
            else load_snapshot(SNAPSHOTS[name])
        )
        frames.append(df)
        weights.append(
            np.full(len(df), weight_map.get(name, 1.0), dtype="float32")
        )
    combined = pd.concat(frames, ignore_index=True, copy=False)
    combined_weights = np.concatenate(weights)
    del frames
    gc.collect()
    return combined, combined_weights


def make_catboost():
    return CatBoostRegressor(
        loss_function="RMSE",
        eval_metric="RMSE",
        iterations=3000,
        learning_rate=0.03,
        depth=8,
        l2_leaf_reg=5,
        random_strength=0.5,
        random_seed=42,
        thread_count=-1,
        allow_writing_files=False,
    )


def make_lgbm_rmse():
    return LGBMRegressor(
        objective="regression",
        n_estimators=3000,
        learning_rate=0.03,
        num_leaves=63,
        max_depth=-1,
        min_child_samples=100,
        subsample=0.8,
        subsample_freq=1,
        colsample_bytree=0.8,
        reg_alpha=0.1,
        reg_lambda=1.0,
        max_bin=255,
        random_state=42,
        n_jobs=-1,
        verbosity=-1,
    )


def make_lgbm_tweedie():
    return LGBMRegressor(
        objective="tweedie",
        tweedie_variance_power=1.3,
        n_estimators=3000,
        learning_rate=0.03,
        num_leaves=63,
        max_depth=-1,
        min_child_samples=100,
        subsample=0.8,
        subsample_freq=1,
        colsample_bytree=0.8,
        reg_alpha=0.1,
        reg_lambda=1.0,
        max_bin=255,
        random_state=42,
        n_jobs=-1,
        verbosity=-1,
    )


# ==========================================
# 3. WALK-FORWARD CV
# ==========================================
weight_map = {"march8_analog": MARCH8_SAMPLE_WEIGHT} if HAS_MARCH8_ANALOG else {}

cv_rows = []
oof_cat, oof_rmse, oof_tweedie, oof_y = [], [], [], []

for i, valid_name in enumerate(FOLD_ORDER[1:], start=1):
    train_names = FOLD_ORDER[:i] + (
        ["march8_analog"] if HAS_MARCH8_ANALOG else []
    )
    print(f"\n=== Fold: train={train_names}  valid={valid_name} ===")

    train_df, train_weights = concat_with_weights(train_names, weight_map)
    valid_df = load_snapshot(SNAPSHOTS[valid_name])

    y_train = train_df["target"].to_numpy("float32")
    y_valid = valid_df["target"].to_numpy("float32")
    y_train_log = np.log1p(y_train)
    y_valid_log = np.log1p(y_valid)

    cat_model = make_catboost()
    cat_model.fit(
        train_df[FEATURES], y_train_log,
        sample_weight=train_weights,
        eval_set=(valid_df[FEATURES], y_valid_log),
        early_stopping_rounds=150, use_best_model=True, verbose=False,
    )

    lgbm_rmse_model = make_lgbm_rmse()
    lgbm_rmse_model.fit(
        train_df[FEATURES], y_train_log,
        sample_weight=train_weights,
        eval_set=[(valid_df[FEATURES], y_valid_log)],
        eval_metric="rmse",
        callbacks=[lgb.early_stopping(100), lgb.log_evaluation(0)],
    )

    lgbm_tweedie_model = make_lgbm_tweedie()
    lgbm_tweedie_model.fit(
        train_df[FEATURES], y_train,
        sample_weight=train_weights,
        eval_set=[(valid_df[FEATURES], y_valid)],
        eval_metric="rmse",
        callbacks=[lgb.early_stopping(100), lgb.log_evaluation(0)],
    )

    cat_pred = np.expm1(np.maximum(cat_model.predict(valid_df[FEATURES]), 0))
    rmse_pred = np.expm1(
        np.maximum(lgbm_rmse_model.predict(valid_df[FEATURES]), 0)
    )
    tweedie_pred = np.maximum(
        lgbm_tweedie_model.predict(valid_df[FEATURES]), 0
    )
    equal_blend = (cat_pred + rmse_pred + tweedie_pred) / 3

    row = {
        "fold": valid_name,
        "catboost": root_mean_squared_log_error(y_valid, cat_pred),
        "lgbm_rmse": root_mean_squared_log_error(y_valid, rmse_pred),
        "lgbm_tweedie": root_mean_squared_log_error(y_valid, tweedie_pred),
        "equal_blend": root_mean_squared_log_error(y_valid, equal_blend),
        "cat_best_iter": cat_model.get_best_iteration(),
        "lgbm_rmse_best_iter": lgbm_rmse_model.best_iteration_,
        "lgbm_tweedie_best_iter": lgbm_tweedie_model.best_iteration_,
    }
    cv_rows.append(row)
    print(row)

    oof_cat.append(cat_pred)
    oof_rmse.append(rmse_pred)
    oof_tweedie.append(tweedie_pred)
    oof_y.append(y_valid)

    del train_df, valid_df, cat_model, lgbm_rmse_model, lgbm_tweedie_model
    gc.collect()

cv_df = pd.DataFrame(cv_rows)
print("\n=== CV по фолдам ===")
print(cv_df)
print("\nСредние по фолдам:")
print(cv_df[["catboost", "lgbm_rmse", "lgbm_tweedie", "equal_blend"]].mean())

# ==========================================
# 4. ПОДБОР ВЕСОВ АНСАМБЛЯ ПО OOF
# ==========================================
oof_cat = np.concatenate(oof_cat)
oof_rmse = np.concatenate(oof_rmse)
oof_tweedie = np.concatenate(oof_tweedie)
oof_y = np.concatenate(oof_y)

best_weights, best_oof_score = (1 / 3, 1 / 3, 1 / 3), np.inf
step = 0.05
grid = np.arange(0, 1 + step, step)
for w_cat, w_rmse in itertools.product(grid, grid):
    w_tweedie = 1 - w_cat - w_rmse
    if w_tweedie < -1e-9 or w_tweedie > 1 + 1e-9:
        continue
    w_tweedie = max(w_tweedie, 0.0)
    blend = w_cat * oof_cat + w_rmse * oof_rmse + w_tweedie * oof_tweedie
    score = root_mean_squared_log_error(oof_y, np.maximum(blend, 0))
    if score < best_oof_score:
        best_oof_score = score
        best_weights = (w_cat, w_rmse, w_tweedie)

print(f"\nЛучшие веса (cat, lgbm_rmse, lgbm_tweedie): {best_weights}")
print(f"OOF RMSLE ансамбля: {best_oof_score:.6f}")

del oof_cat, oof_rmse, oof_tweedie, oof_y
gc.collect()


# ==========================================
# 5. ФИНАЛЬНОЕ ОБУЧЕНИЕ
# ==========================================
fit_names = [n for n in FOLD_ORDER if n != "jan14"] + (
    ["march8_analog"] if HAS_MARCH8_ANALOG else []
)
fit_df, fit_weights = concat_with_weights(fit_names, weight_map)
holdout_df = load_snapshot(SNAPSHOTS["jan14"])

y_fit = fit_df["target"].to_numpy("float32")
y_fit_log = np.log1p(y_fit)
y_holdout = holdout_df["target"].to_numpy("float32")
y_holdout_log = np.log1p(y_holdout)

print("\n--- Подбор итераций: CatBoost ---")
tuning_cat = make_catboost()
tuning_cat.fit(
    fit_df[FEATURES], y_fit_log,
    sample_weight=fit_weights,
    eval_set=(holdout_df[FEATURES], y_holdout_log),
    early_stopping_rounds=150, use_best_model=True, verbose=200,
)
best_cat_iterations = tuning_cat.get_best_iteration()

print("\n--- Подбор итераций: LightGBM RMSE ---")
tuning_lgbm_rmse = make_lgbm_rmse()
tuning_lgbm_rmse.fit(
    fit_df[FEATURES], y_fit_log,
    sample_weight=fit_weights,
    eval_set=[(holdout_df[FEATURES], y_holdout_log)],
    eval_metric="rmse",
    callbacks=[lgb.early_stopping(100), lgb.log_evaluation(200)],
)
best_lgbm_rmse_iterations = tuning_lgbm_rmse.best_iteration_

print("\n--- Подбор итераций: LightGBM Tweedie ---")
tuning_lgbm_tweedie = make_lgbm_tweedie()
tuning_lgbm_tweedie.fit(
    fit_df[FEATURES], y_fit,
    sample_weight=fit_weights,
    eval_set=[(holdout_df[FEATURES], y_holdout)],
    eval_metric="rmse",
    callbacks=[lgb.early_stopping(100), lgb.log_evaluation(200)],
)
best_lgbm_tweedie_iterations = tuning_lgbm_tweedie.best_iteration_

print(
    f"\nЛучшие итерации: cat={best_cat_iterations}, "
    f"lgbm_rmse={best_lgbm_rmse_iterations}, "
    f"lgbm_tweedie={best_lgbm_tweedie_iterations}"
)

del fit_df, holdout_df, tuning_cat, tuning_lgbm_rmse, tuning_lgbm_tweedie
gc.collect()

# Финальный рефит на всем датасете
all_names = FOLD_ORDER + (["march8_analog"] if HAS_MARCH8_ANALOG else [])
full_df, full_weights = concat_with_weights(all_names, weight_map)
y_full = full_df["target"].to_numpy("float32")
y_full_log = np.log1p(y_full)

print("\n--- Финальный CatBoost ---")
final_cat = make_catboost()
final_cat.set_params(iterations=best_cat_iterations)
final_cat.fit(full_df[FEATURES], y_full_log, sample_weight=full_weights, verbose=200)

print("\n--- Финальный LightGBM RMSE ---")
final_lgbm_rmse = make_lgbm_rmse()
final_lgbm_rmse.set_params(n_estimators=best_lgbm_rmse_iterations)
final_lgbm_rmse.fit(full_df[FEATURES], y_full_log, sample_weight=full_weights)

print("\n--- Финальный LightGBM Tweedie ---")
final_lgbm_tweedie = make_lgbm_tweedie()
final_lgbm_tweedie.set_params(n_estimators=best_lgbm_tweedie_iterations)
final_lgbm_tweedie.fit(full_df[FEATURES], y_full, sample_weight=full_weights)

del full_df
gc.collect()

# ==========================================
# 6. ИНФЕРЕНС И СОХРАНЕНИЕ САБМИТОВ
# ==========================================
print("\nЗагрузка competition_test...")
competition_df = pd.read_parquet(
    COMPETITION_FILE, columns=["user_id"] + FEATURES
)
competition_df[FEATURES] = competition_df[FEATURES].astype("float32")

cat_pred = np.expm1(
    np.maximum(final_cat.predict(competition_df[FEATURES]), 0)
)
rmse_pred = np.expm1(
    np.maximum(final_lgbm_rmse.predict(competition_df[FEATURES]), 0)
)
tweedie_pred = np.maximum(
    final_lgbm_tweedie.predict(competition_df[FEATURES]), 0
)

w_cat, w_rmse, w_tweedie = best_weights
blend_pred = np.maximum(
    w_cat * cat_pred + w_rmse * rmse_pred + w_tweedie * tweedie_pred,
    0,
)

# Сохранение непосредственно в /kaggle/working/
pd.DataFrame(
    {"user_id": competition_df["user_id"], "predict": cat_pred}
).to_csv(OUTPUT_DIR / "submission_catboost.csv", index=False)
pd.DataFrame(
    {"user_id": competition_df["user_id"], "predict": rmse_pred}
).to_csv(OUTPUT_DIR / "submission_lgbm_rmse.csv", index=False)
pd.DataFrame(
    {"user_id": competition_df["user_id"], "predict": tweedie_pred}
).to_csv(OUTPUT_DIR / "submission_lgbm_tweedie.csv", index=False)
pd.DataFrame(
    {"user_id": competition_df["user_id"], "predict": blend_pred}
).to_csv(OUTPUT_DIR / "submission_blend.csv", index=False)

print(f"\nГотово! Веса бленда: {best_weights}, OOF RMSLE: {best_oof_score:.6f}")
print(f"Все файлы сохранены напрямую в {OUTPUT_DIR.resolve()}")
